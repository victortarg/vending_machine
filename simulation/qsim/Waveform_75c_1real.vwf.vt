`timescale 1 ps/ 1 ps
module vending_machine_vlg_sample_tst(
	clock,
	moeda_1_real,
	moeda_25_centavos,
	moeda_50_centavos,
	preco_produto,
	reset,
	seletor_produto,
	sampler_tx
);
input  clock;
input  moeda_1_real;
input  moeda_25_centavos;
input  moeda_50_centavos;
input [7:0] preco_produto;
input  reset;
input [2:0] seletor_produto;
output sampler_tx;

reg sample;
time current_time;
always @(clock or moeda_1_real or moeda_25_centavos or moeda_50_centavos or preco_produto or reset or seletor_produto)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

