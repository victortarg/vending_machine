	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module vending_machine_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clock;
reg moeda_1_real;
reg moeda_25_centavos;
reg moeda_50_centavos;
reg [7:0] preco_produto;
reg reset;
reg [2:0] seletor_produto;
// wires                                               
wire libera_moeda_troco;
wire [7:0] libera_produto;
wire [31:0] monitor_estado;
wire [31:0] monitor_total;

wire sampler;                             

// assign statements (if any)                          
vending_machine i1 (
// port map - connection between master ports and signals/registers   
	.clock(clock),
	.libera_moeda_troco(libera_moeda_troco),
	.libera_produto(libera_produto),
	.moeda_1_real(moeda_1_real),
	.moeda_25_centavos(moeda_25_centavos),
	.moeda_50_centavos(moeda_50_centavos),
	.monitor_estado(monitor_estado),
	.monitor_total(monitor_total),
	.preco_produto(preco_produto),
	.reset(reset),
	.seletor_produto(seletor_produto)
);

// clock
always
begin
	clock = 1'b0;
	clock = #5000 1'b1;
	#5000;
end 

// reset
initial
begin
	reset = 1'b1;
	reset = #10000 1'b0;
end 

// moeda_25_centavos
initial
begin
	moeda_25_centavos = 1'b0;
end 

// moeda_50_centavos
initial
begin
	moeda_50_centavos = 1'b0;
end 

// moeda_1_real
initial
begin
	moeda_1_real = 1'b0;
	moeda_1_real = #120000 1'b1;
	moeda_1_real = #90000 1'b0;
end 
// seletor_produto[ 2 ]
initial
begin
	seletor_produto[2] = 1'b1;
end 
// seletor_produto[ 1 ]
initial
begin
	seletor_produto[1] = 1'b0;
end 
// seletor_produto[ 0 ]
initial
begin
	seletor_produto[0] = 1'b1;
end 
// preco_produto[ 7 ]
initial
begin
	preco_produto[7] = 1'b0;
	preco_produto[7] = #10000 1'b1;
end 
// preco_produto[ 6 ]
initial
begin
	preco_produto[6] = 1'b0;
	preco_produto[6] = #10000 1'b1;
end 
// preco_produto[ 5 ]
initial
begin
	preco_produto[5] = 1'b0;
	preco_produto[5] = #10000 1'b1;
end 
// preco_produto[ 4 ]
initial
begin
	preco_produto[4] = 1'b0;
	preco_produto[4] = #10000 1'b1;
end 
// preco_produto[ 3 ]
initial
begin
	preco_produto[3] = 1'b0;
	preco_produto[3] = #10000 1'b1;
end 
// preco_produto[ 2 ]
initial
begin
	preco_produto[2] = 1'b0;
end 
// preco_produto[ 1 ]
initial
begin
	preco_produto[1] = 1'b0;
	preco_produto[1] = #10000 1'b1;
end 
// preco_produto[ 0 ]
initial
begin
	preco_produto[0] = 1'b0;
end 

vending_machine_vlg_sample_tst tb_sample (
	.clock(clock),
	.moeda_1_real(moeda_1_real),
	.moeda_25_centavos(moeda_25_centavos),
	.moeda_50_centavos(moeda_50_centavos),
	.preco_produto(preco_produto),
	.reset(reset),
	.seletor_produto(seletor_produto),
	.sampler_tx(sampler)
);

vending_machine_vlg_check_tst tb_out(
	.libera_moeda_troco(libera_moeda_troco),
	.libera_produto(libera_produto),
	.monitor_estado(monitor_estado),
	.monitor_total(monitor_total),
	.sampler_rx(sampler)
);
endmodule

